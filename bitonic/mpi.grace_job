#!/bin/bash

##NECESSARY JOB SPECIFICATIONS
#SBATCH --job-name=bitonic       #Set the job name
#SBATCH --time=0:10:00           #Set the wall clock limit
#SBATCH --nodes=1                #Overridden by submit.sh for large P
#SBATCH --ntasks-per-node=2      #Overridden by submit.sh
#SBATCH --mem=16G                #Request memory per node
#SBATCH --output=logs/output.%j  #Send stdout/err to "logs/output.[jobID]"
#
##First Executable Line
#
# usage: sbatch [flags] mpi.grace_job <N> <P> <input_type> [strong|weak]
#   input_type: Sorted | ReverseSorted | Random | 1_perc_perturbed
# submit.sh puts the right --nodes / --ntasks-per-node flags in front.
N=$1
processes=$2
input_type=${3:-Random}
scalability=${4:-strong}

if [ -z "$N" ] || [ -z "$processes" ]; then
    echo "usage: sbatch mpi.grace_job <N> <P> <input_type> [strong|weak]"
    exit 1
fi

module load GCC/11.3.0
module load GCC/12.2.0
module load NVHPC/22.7-CUDA-11.7.0
module load OpenMPI/4.1.4
module load CMake/3.12.1
module load GCCcore/12.2.0
module load PAPI/7.0.1

echo "job=$SLURM_JOB_ID N=$N P=$processes input_type=$input_type scalability=$scalability"
echo "nodes=$SLURM_JOB_NUM_NODES nodelist=$SLURM_JOB_NODELIST tasks_per_node=$SLURM_TASKS_PER_NODE"

mkdir -p cali

# One .cali file per run. profile.mpi adds the MPI_* nodes to the calltree
# (see the example calltree in Report.md section 3a). Set MPI_PROFILE="" to drop it.
MPI_PROFILE=${MPI_PROFILE-",profile.mpi"}
califile="cali/bitonic-${input_type}-${N}-${processes}-${SLURM_JOB_ID}.cali"

CALI_CONFIG="spot(output=${califile}${MPI_PROFILE})" \
mpirun -np $processes ./bitonic $N $input_type $scalability
echo "mpirun_exit=$? cali=$califile"

squeue -j $SLURM_JOBID
